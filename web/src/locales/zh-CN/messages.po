msgstr "请确认这是你想要的提交。"

msgid "Check that it reads its data, and restore a backup if it won't."
msgstr "请检查它能否读取数据，如无法读取，请恢复备份。"

msgid "Check that it will before you apply, and restore a backup if it won't."
msgstr "请在应用前检查，如无法读取，请恢复备份。"

msgid "Check that the app reads its data, and if it doesn't, restore {which}, from {when}."
msgstr "请检查应用能否读取数据，如不能，请恢复 {which}，创建于 {when}。"

msgid "Check that the app reads its data, and restore a backup of your own if it doesn't."
msgstr "请检查应用能否读取数据，如果不能，请恢复你自己的备份。"

