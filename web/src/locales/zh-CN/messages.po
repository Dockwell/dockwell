msgstr "{0} 会将 {name} 的数据保留 7 天，然后删除"

msgid "{by} writes there as a user by name, which only its image can say is root or not."
msgstr "{by} 以按名称指定的用户在那里写入，只有它的镜像能确定该用户是不是 root。"

msgid "{by} writes there as its own user, who is root unless the image says otherwise."
msgstr "{by} 以镜像自身的用户在那里写入，除非镜像另有指定，否则就是 root。"

msgid "{by} writes there as root, so it can change any file there, whoever owns it, and leave files that run as root."
msgstr "{by} 以 root 在那里写入，所以无论文件属于谁都能修改，还能留下以 root 运行的文件。"

msgid "{by} writes there. Code from another image asks again, as a program in any image can run as root."
msgstr "{by} 在那里写入。换成其他镜像的代码时需要重新确认，因为任何镜像中的程序都可能以 root 运行。"

msgid "{count, plural, one {The catalog shows # app from this commit: {names}.} other {The catalog shows # apps from this commit: {names}.}}"
msgstr "{count, plural, other {应用目录将显示这个提交中的 # 个应用：{names}。}}"

msgid "{counts} {lifting}"
msgstr "{counts}{lifting}"

msgid "{database} starts anew on an empty volume and loads the dump, {size}, so what was made since goes."
msgstr "{database} 会在空卷上重新开始并加载转储（{size}），因此之后产生的内容将丢失。"

msgid "{heldBy} can move what {path} leads to on {server}"
msgstr "{heldBy} 可以改变 {server} 上 {path} 指向的位置"

msgid "{ids} will come from another catalog"
msgstr "{ids} 将改由另一个目录提供"

msgid "{name} answers plain HTTP on {path} on {server}"
msgstr "{name} 在 {server} 上以明文 HTTP 响应 {path}"

msgid "{name} believes the proxy {path} on {server}"
msgstr "{name} 在 {server} 上信任代理 {path}"

msgid "{name} can move what {held} leads to on {server}"
msgstr "{name} 可以改变 {server} 上 {held} 指向的位置"

msgid "{name} gets back the data the server kept."
msgstr "{name} 将取回服务器保留的数据。"

msgid "{name} gets back what reached root on {server}"
msgstr "{name} 将恢复曾可访问 {server} root 级内容的备份"

msgid "{name} gets root on {server}"
msgstr "{name} 将获得 {server} 的 root 权限"

msgid "{name} has the Linux capability {path} on {server}"
msgstr "{name} 在 {server} 上拥有 Linux 能力 {path}"

msgid "{name} joins the group {path} on {server}"
msgstr "{name} 在 {server} 上加入用户组 {path}"

msgid "{name} joins the network {path} on {server}"
msgstr "{name} 在 {server} 上加入网络 {path}"

msgid "{name} joins the {leadsTo} network {path} on {server}"
msgstr "{name} 在 {server} 上加入 {leadsTo} 网络 {path}"

msgid "{name} keeps what is in {names} as it is"
msgstr "{name} 保留 {names} 中的内容不变"

msgid "{name} lets in someone {path} kept out"
msgstr "{name} 会放进 {path} 原本挡住的人"

#. placeholder {0}: server.serverName
msgid "{name} loses its data on {0}"
msgstr "{name} 将丢失它在 {0} 上的数据"

msgid "{name} loses what its image keeps at {paths}"
msgstr "{name} 将失去其镜像保存在 {paths} 的内容"

msgid "{name} may take longer to be healthy, as its image isn't on the server yet."
msgstr "{name} 可能需要更久才能恢复健康，因为它的镜像还不在服务器上。"

msgid "{name} mounts <0>{path}</0>, inside <1>{heldIn}</1>, which {heldBy} can write. So {heldBy} can turn it into a link to anywhere on the server, which {name} follows when it next starts. That's as good as root, so from now on any change to {heldBy} but another tag asks for a passkey."
msgstr "{name} 挂载了 <1>{heldIn}</1> 中的 <0>{path}</0>，而 {heldBy} 可以写入该目录。所以 {heldBy} 能把它改成指向服务器上任意位置的链接，{name} 下次启动时就会跟随该链接。这相当于拥有 root，所以从现在起，对 {heldBy} 的任何更改（另一个标签除外）都需要通行密钥。"

msgid "{name} mounts the volume {path} on {server}"
msgstr "{name} 在 {server} 上挂载卷 {path}"

msgid "{name} mounts {path}, inside {heldIn}, which {heldBy} can write."
msgstr "{name} 挂载了 {heldIn} 中的 {path}，而 {heldBy} 可以写入 {heldIn}。"

msgid "{name} moves back to {to} only if its data allows"
msgstr "只有数据允许时，{name} 才会退回 {to}"

msgid "{name} reaches the port {path} on {server}"
msgstr "{name} 在 {server} 上可访问端口 {path}"

msgid "{name} reaches {path} on {server}"
msgstr "{name} 可访问 {server} 上的 {path}"

msgid "{name} reaches {path} on {server}, which leads to {leadsTo}"
msgstr "{name} 可访问 {server} 上的 {path}，它指向 {leadsTo}"

msgid "{name} reaches {reach} on {server}"
msgstr "{name} 可访问 {server} 上的 {reach}"

msgid "{name} runs a shell command as root on {server}"
msgstr "{name} 在 {server} 上以 root 身份运行 shell 命令"

msgid "{name} runs with the latest value of {names}"
msgstr "{name} 使用 {names} 的最新值运行"

msgid "{name} runs {image} as revision {revision} ran it, {digest}, even if the tag has moved since"
msgstr "{name} 按修订版本 {revision} 当时的方式运行 {image}（{digest}），即使该标签此后已指向别处"

msgid "{name} sends a certificate's key for {path} to {server} for the first time"
msgstr "{name} 首次将 {path} 的证书密钥发送到 {server}"

msgid "{name} sends the key of the shared certificate for {names} to {server} for the first time"
msgstr "{name} 首次将 {names} 的共享证书密钥发送到 {server}"

msgid "{name} shares {server}'s own network"
msgstr "{name} 与 {server} 共用其自身的网络"

msgid "{name} stops HTTPS on {path} on {server}"
msgstr "{name} 在 {server} 上停止 {path} 的 HTTPS"

msgid "{name} takes on the container {path} on {server}"
msgstr "{name} 在 {server} 上接管容器 {path}"

msgid "{name}'s data isn't backed up first"
msgstr "{name} 的数据不会先备份"

msgid "{name}'s data uses {features}'s features, which {to} can't run"
msgstr "{name} 的数据用到了 {features} 的功能，{to} 无法运行"

msgid "{name}'s features go up to {from} before it moves to {to}"
msgstr "{name} 在升级到 {to} 之前，功能先提升到 {from}"

msgid "{name}'s kept logs can't be read from then on, and go in 7 days. Undoing this brings them back."
msgstr "此后无法读取 {name} 保留的日志，这些日志会在 7 天后删除。撤销此操作可恢复它们。"

msgid "{name}'s rollout order says to start first, so the old and new containers both write there for as long as this takes."
msgstr "{name} 的发布顺序设置为先启动，因此在此过程中新旧容器都会写入那里。"

msgid "{name}'s scheduled tasks get the same reach"
msgstr "{name} 的计划任务获得同样的访问范围"

msgid "{name}'s tmpfs at {target} has no size"
msgstr "{name} 的 tmpfs({target})没有设置大小"

msgid "{name}'s {where} hold the value of {variable}"
msgstr "{name} 的 {where} 中含有 {variable} 的值"

msgid "{name}'s {where} hold the value of {variable} from your .env"
msgstr "{name} 的 {where} 中含有你的 .env 里 {variable} 的值"

msgid "{name}'s {where} holds the value of {variable}"
msgstr "{name} 的 {where} 中含有 {variable} 的值"

msgid "{name}'s {where} holds the value of {variable} from your .env"
msgstr "{name} 的 {where} 中含有你的 .env 里 {variable} 的值"

