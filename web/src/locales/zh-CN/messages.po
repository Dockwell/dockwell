#. placeholder {0}: line.text
msgid "{name}: {0}"
msgstr "{name}：{0}"

msgid "{projects} can upgrade again, from the catalog each came from."
msgstr "{projects} 可以再次从各自的来源目录升级。"

msgid "{projects} will have no upgrades"
msgstr "{projects} 将不再有升级"

msgid "{project} already runs {names}"
msgstr "{project} 已在运行 {names}"

msgid "{project} already runs {names}, and this deletes {deleted}"
msgstr "{project} 已在运行 {names}，此计划会删除 {deleted}"

msgid "{server} is offline, so what it kept of {name} stays on its disk until it's back"
msgstr "{server} 已离线，它保留的 {name} 日志会留在磁盘上，直到它恢复连接"

msgid "{tool} still manages {container}"
msgstr "{tool} 仍在管理 {container}"

msgid "{writtenBy} wrote these files, and {runsOn} runs on them now"
msgstr "这些文件由 {writtenBy} 写入，而现在运行的是 {runsOn}"

msgid "A container on the server's own network listens on the server's ports itself, so two can't run at once, and the old one stops first"
msgstr "服务器自身网络上的容器直接监听服务器的端口，因此两个容器不能同时运行，旧容器会先停止"

msgid "A new container takes over once it has been healthy for {soak}, and what runs goes on serving until then. If it isn't healthy within {healthyWithin}, Dockwell rolls this back"
msgstr "新容器保持健康 {soak} 后接管，在此之前正在运行的容器继续提供服务。如果它在 {healthyWithin} 内未变为健康，Dockwell 会回滚此更改"

msgid "A new container takes over once it has been healthy for {soak}, and what runs goes on serving until then. If it isn't healthy within {healthyWithin}, the new one goes, and what runs stays"
msgstr "新容器保持健康 {soak} 后接管，在此之前正在运行的容器继续提供服务。如果它在 {healthyWithin} 内未变为健康，新容器会被移除，正在运行的容器保留"

msgid "API token"
msgstr "API 令牌"

msgid "Also created {list}"
msgstr "还创建了{list}"

msgid "Also creates {list}"
msgstr "还会创建{list}"

msgid "Anyone visiting {where} gets a browser's connection error, as nothing here answers for that name over HTTPS any more."
msgstr "访问 {where} 的人会看到浏览器连接错误，因为这里不再通过 HTTPS 响应该名称。"

msgid "Anyone visiting {where} gets a refused connection, as nothing answers on this server's port any more."
msgstr "访问 {where} 的人会被拒绝连接，因为此服务器的端口上不再有任何响应。"

msgid "Anyone visiting {where} gets what the rest of {domain} serves, or a 404 if nothing covers that path."
msgstr "访问 {where} 的人会看到 {domain} 其余部分提供的内容；如果没有内容覆盖该路径，则看到 404。"

msgid "Anyone visiting {where} stops reaching it."
msgstr "访问 {where} 的人将无法再访问到它。"

msgid "Automatic"
msgstr "自动"

msgid "Build and deploy {commit}"
msgstr "构建并部署 {commit}"

msgid "Building and deploying {commit}"
msgstr "正在构建并部署 {commit}"

