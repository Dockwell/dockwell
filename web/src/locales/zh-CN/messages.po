msgstr "从现在起不要在 {tool} 中操作它。"

msgid "Leaves out {file}"
msgstr "不收录 {file}"

msgid "Lower its feature compatibility version to {to} first if it's higher."
msgstr "如果它的功能兼容版本更高，请先降到 {to}。"

msgid "Lower its feature compatibility version to {to} first."
msgstr "请先把它的功能兼容版本降到 {to}。"

