msgstr "无法创建"

msgid "Couldn't delete"
msgstr "无法删除"

msgid "Couldn't deploy {commit}"
msgstr "无法部署 {commit}"

msgid "Couldn't deploy {image}"
msgstr "无法部署 {image}"

msgid "Couldn't let go of"
msgstr "无法放开"

msgid "Couldn't publish port {port}"
msgstr "无法发布端口 {port}"

msgid "Couldn't pull {image}"
msgstr "无法拉取 {image}"

msgid "Couldn't replace"
msgstr "无法替换"

