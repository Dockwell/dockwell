msgstr "MongoDB 只能从与当前版本一致的数据迁移，因此它的功能兼容版本会先提升到 {from}，此后它的数据可能用到 {from} 的功能。"

msgid "More than one container answers to {shared} on {network}"
msgstr "在 {network} 上有多个容器响应 {shared}"

msgid "Moves {names} on, which an install of each can upgrade to."
msgstr "更新 {names}，已安装的实例可以升级到新版本。"

msgid "Name a network the proxy has to itself."
msgstr "请指定一个由该代理独占的网络。"

msgid "No backup is taken first"
msgstr "升级前不会创建备份"

msgid "No backup was taken, and the data stays as it is now"
msgstr "没有做过备份,数据保持现状"

msgid "No branch or tag is at this commit now"
msgstr "当前没有分支或标签指向这个提交"

