# and the package managers.
/gen/**                             linguist-generated=true
/packages/api/src/gen/**            linguist-generated=true
/packages/ui/src/tokens.ts          linguist-generated=true
/packages/ui/src/styles/tokens.css  linguist-generated=true
/web/src/routeTree.gen.ts           linguist-generated=true
go.sum                              linguist-generated=true
tools/go.sum                        linguist-generated=true
pnpm-lock.yaml                      linguist-generated=true

